# --- Agente de IA del sitio (server/ai-chat-server.mjs) ---------------------
# Se acepta UNO de dos proveedores (si ambos están, gana Anthropic):
#
# Opción A — API de Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=
#
# Opción B — cualquier API compatible con OpenAI (MiniMax, etc.)
# AI_API_KEY=
# AI_API_URL=https://api.minimax.io/v1
# AI_MODEL=MiniMax-M2

# Opcionales
# Versión EXACTA del modelo (fijada, nunca alias flotante).
# Con Anthropic por defecto: claude-haiku-4-5-20251001
# Con proveedor OpenAI-compatible se usa AI_MODEL si no se define.
# AI_CHAT_MODEL=
AI_CHAT_PORT=8787
# Tope de tokens por respuesta (por defecto 512 Anthropic / 2048 OpenAI-compat,
# los modelos con razonamiento necesitan margen para pensar)
# AI_CHAT_MAX_TOKENS=
# En producción restringe el origen, ej. https://elbedi.com
AI_CHAT_ALLOWED_ORIGIN=*
WHATSAPP_PHONE=+525546602947

# --- Frontend (Astro, se hornea en build) ------------------------------------
# URL pública del endpoint del agente en producción. En dev no hace falta:
# `npm run dev` levanta Astro + agente IA y hace proxy de /api/ai/*
# PUBLIC_AI_CHAT_ENDPOINT=https://ai.elbedi.com/api/chat
