---
import "../styles/app.css";
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import siteConfig from "../config/siteConfig.js";
import Head from "./partials/head.jsx";
import site from "../content/site";
import Header from "./partials/header.jsx";
import Footer from "./partials/footer.jsx";
import Preloader from "./partials/Preloader.astro";
import BgTransition from "@/components/motion/bgTransition.jsx";
import Figures from "@/components/motion/Figures.jsx";
import WhatsApp from "@/components/common/whatsApp.jsx";

const currentCanonical = Astro.url
  ? new URL(Astro.url.pathname, siteConfig.url).toString()
  : siteConfig.url;

const {
  title = siteConfig.title,
  description = siteConfig.description,
  canonicalUrl = currentCanonical,
  ogImage = siteConfig.mainImage,
  ogImageAlt = siteConfig.mainImageAlt,
  robots = siteConfig.robots,
  schema = [],
} = Astro.props;
---

<!doctype html>
<html lang={siteConfig.lang} class="dark">
  <Head
    title={title}
    description={description}
    canonicalUrl={canonicalUrl}
    ogImage={ogImage}
    ogImageAlt={ogImageAlt}
    robots={robots}
    schema={schema}
  />
  <body class="text-white">
    <a class="global-skip-link" href="#main-content">Ir al contenido</a>
    <Preloader />

    <BgTransition client:load />
    <Figures client:load />
    <Header brand={site.name} />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer
      client:visible
      brand={site.name}
      email={site.email}
      phone={site.phone}
    />

    <WhatsApp phone={site.phone} client:load />

    <Analytics />
    <SpeedInsights />
    <script is:inline src="/scripts/lenis-init.js"></script>
  </body>
</html>
