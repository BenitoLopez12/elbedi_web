---
// Layout de la experiencia cinematográfica (index): sin scroll de documento,
// sin header/footer clásicos — el escenario, el scroll inteligente y el
// agente de IA son la interfaz.
import "../styles/app.css";
import "../styles/experience.css";
import siteConfig from "../config/siteConfig.js";
import Head from "./partials/head.jsx";
import Preloader from "./partials/Preloader.astro";

const currentCanonical = Astro.url
  ? new URL(Astro.url.pathname, siteConfig.url).toString()
  : siteConfig.url;

const {
  title = siteConfig.title,
  description = siteConfig.description,
  canonicalUrl = currentCanonical,
  ogImage = siteConfig.mainImage,
  robots = siteConfig.robots,
  schema = [],
} = Astro.props;
---

<!doctype html>
<html lang={siteConfig.lang} class="dark cine-experience">
  <Head
    title={title}
    description={description}
    canonicalUrl={canonicalUrl}
    ogImage={ogImage}
    robots={robots}
    schema={schema}
  />
  <body class="text-white">
    <Preloader />
    <slot />
  </body>
</html>
