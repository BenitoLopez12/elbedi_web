---
// Index — ELBEDI Studio: experiencia cinematográfica del estudio de
// desarrollo e inteligencia artificial.
import ExperienceLayout from "@/layouts/ExperienceLayout.astro";
import Experience from "@/experience/Experience.jsx";
import siteConfig from "@/config/siteConfig.js";
import { FAQS } from "@/content/experience.js";
import { SERVICE_PAGES } from "@/content/servicePages.js";
import {
  buildFaqSchema,
  buildItemListSchema,
  buildOrganizationSchema,
  buildSchemaGraph,
  buildServiceSchema,
  buildWebPageSchema,
  buildWebsiteSchema,
} from "@/lib/seo.js";

const canonicalUrl = `${siteConfig.url}/`;
const title = "ELBEDI | Inteligencia Artificial para Empresas en México";
const description =
  "Implementamos inteligencia artificial en empresas: agentes para WhatsApp, sistemas agénticos, analítica con IA y sitios web inteligentes en México.";
const homeSchema = buildSchemaGraph([
  buildOrganizationSchema(),
  buildWebsiteSchema(),
  buildWebPageSchema({ url: "/", name: title, description }),
  buildItemListSchema(SERVICE_PAGES, { url: "/", name: "Servicios de ELBEDI" }),
  ...SERVICE_PAGES.map((service) =>
    buildServiceSchema({ ...service, description: service.metaDescription }),
  ),
  buildFaqSchema(FAQS, "/"),
]);
---

<ExperienceLayout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  schema={homeSchema}>
  <Experience client:load />
</ExperienceLayout>
