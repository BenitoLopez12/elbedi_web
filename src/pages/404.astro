---
import SeoPageLayout from "@/layouts/SeoPageLayout.astro";
---

<SeoPageLayout
  title="Página no encontrada | ELBEDI"
  description="La página solicitada no existe. Regresa al inicio o consulta los servicios de inteligencia artificial de ELBEDI."
  robots="noindex,follow"
  canonicalUrl="https://elbedi.com/404">
  <section class="seo-hero">
    <div class="seo-container seo-hero__content">
      <p class="seo-eyebrow">Error 404</p>
      <h1 class="seo-display seo-display--compact">Esta ruta no forma parte del sistema.</h1>
      <p class="seo-lead">Puedes regresar a la experiencia principal o explorar nuestras soluciones.</p>
      <div class="seo-actions">
        <a class="seo-button seo-button--primary" href="/">Volver al inicio</a>
        <a class="seo-button seo-button--secondary" href="/servicios">Ver servicios</a>
      </div>
    </div>
  </section>
</SeoPageLayout>
