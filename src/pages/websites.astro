---
import Layout from "@/layouts/Layout.astro";
import siteConfig from "@/config/siteConfig.js";
import { SEO_FAQS, SEO_SERVICES } from "@/content/seoContent.js";
import {
  buildBreadcrumbSchema,
  buildFaqSchema,
  buildOrganizationSchema,
  buildSchemaGraph,
  buildServiceSchema,
  buildWebPageSchema,
  buildWebsiteSchema,
} from "@/lib/seo.js";
import Hero from "@/sections/hero/Hero.jsx";
import Services from "@/sections/services/Services";
import Sectors from "@/sections/sectors/sectors.jsx";
import Projects from "@/sections/projects/Projects.jsx";
import Plans from "@/sections/plans/plans.jsx";
import Faq from "@/sections/faq/Faq.jsx";
import Contact from "@/sections/contact/Contact.jsx";

const canonicalUrl = `${siteConfig.url}/websites`;
const title = "ELBEDI Websites | Diseño y Desarrollo Web en México";
const description =
  "Diseño y desarrollo de sitios web para negocios en México. Creamos páginas rápidas, seguras y orientadas a conversión con soporte continuo.";
const websiteService = buildServiceSchema({
  url: "/websites",
  name: "Diseño y desarrollo de sitios web",
  serviceType: "Diseño web, desarrollo web y SEO técnico",
  description,
});
websiteService.hasOfferCatalog = {
  "@type": "OfferCatalog",
  name: "Servicios digitales ELBEDI Websites",
  itemListElement: SEO_SERVICES.map((service, index) => ({
    "@type": "Offer",
    position: index + 1,
    itemOffered: { "@type": "Service", ...service },
  })),
};
const breadcrumbs = [
  { name: "Inicio", url: "/" },
  { name: "Websites", url: "/websites" },
];
const homeSchema = buildSchemaGraph([
  buildOrganizationSchema(),
  buildWebsiteSchema(),
  buildWebPageSchema({
    url: "/websites",
    name: title,
    description,
    primaryImage: siteConfig.websitesImage,
  }),
  buildBreadcrumbSchema(breadcrumbs),
  websiteService,
  buildFaqSchema(SEO_FAQS, "/websites"),
]);
---

<Layout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  ogImage={siteConfig.websitesImage}
  ogImageAlt={siteConfig.websitesImageAlt}
  schema={homeSchema}>
  <Hero client:load />
  <Services client:load />
  <Projects client:load />
  <Sectors client:load />
  <Plans client:load />
  <Faq />
  <Contact client:load />
</Layout>
